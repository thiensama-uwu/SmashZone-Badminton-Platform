{
  "info": {
    "name": "Project CNM Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Reduced-scope backend collection for frontend integration and demo flows."
  },
  "item": [
    {
      "name": "Auth Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"frontend.user@example.com\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Frontend User\"\n}" }
      }
    },
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"frontend.user@example.com\",\n  \"password\": \"Password@123\"\n}" }
      }
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
      }
    },
    {
      "name": "List Courts",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/courts", "host": ["{{baseUrl}}"], "path": ["courts"] }
      }
    },
    {
      "name": "Get Availability",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/courts/availability?courtId=court_seed_a&date=2026-03-30",
          "host": ["{{baseUrl}}"],
          "path": ["courts", "availability"],
          "query": [
            { "key": "courtId", "value": "court_seed_a" },
            { "key": "date", "value": "2026-03-30" }
          ]
        }
      }
    },
    {
      "name": "Hold Booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Idempotency-Key", "value": "hold-demo-1" }
        ],
        "url": { "raw": "{{baseUrl}}/bookings/hold", "host": ["{{baseUrl}}"], "path": ["bookings", "hold"] },
        "body": { "mode": "raw", "raw": "{\n  \"courtId\": \"court_seed_a\",\n  \"date\": \"2026-03-30\",\n  \"startTime\": \"18:00\",\n  \"endTime\": \"19:00\",\n  \"paymentScenario\": {\n    \"providerStatus\": \"success\",\n    \"autoWebhook\": false\n  }\n}" }
      }
    },
    {
      "name": "Create Booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] },
        "body": { "mode": "raw", "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}" }
      }
    },
    {
      "name": "Create Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Idempotency-Key", "value": "pay-demo-1" }
        ],
        "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] },
        "body": { "mode": "raw", "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"totalAmount\": 180000,\n  \"paymentScenario\": {\n    \"providerStatus\": \"success\",\n    \"autoWebhook\": false\n  }\n}" }
      }
    },
    {
      "name": "Sign Mock Webhook",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/payments/webhook/mock/sign", "host": ["{{baseUrl}}"], "path": ["payments", "webhook", "mock", "sign"] },
        "body": { "mode": "raw", "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"status\": \"success\",\n  \"providerTransactionId\": \"PTRX-DEMO-1\"\n}" }
      }
    },
    {
      "name": "Mock Payment Webhook",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-mock-signature", "value": "{{mockSignature}}" }
        ],
        "url": { "raw": "{{baseUrl}}/payments/webhook/mock", "host": ["{{baseUrl}}"], "path": ["payments", "webhook", "mock"] },
        "body": { "mode": "raw", "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"status\": \"success\",\n  \"providerTransactionId\": \"PTRX-DEMO-1\"\n}" }
      }
    },
    {
      "name": "Booking History",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/bookings/history", "host": ["{{baseUrl}}"], "path": ["bookings", "history"] }
      }
    },
    {
      "name": "List Notifications",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
      }
    },
    {
      "name": "Mark Notifications Read",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/notifications/mark-read", "host": ["{{baseUrl}}"], "path": ["notifications", "mark-read"] },
        "body": { "mode": "raw", "raw": "{\n  \"ids\": []\n}" }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "mockSignature", "value": "" }
  ]
}
